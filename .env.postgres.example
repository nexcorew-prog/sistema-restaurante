# Only for the optional Docker Compose PostgreSQL deployment in docker-compose.yml.
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant_admin
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
POSTGRES_APP_PASSWORD=replace-with-a-different-long-random-app-password
POSTGRES_SSL_CERT_PATH=/etc/postgresql/tls/server.crt
POSTGRES_SSL_KEY_PATH=/etc/postgresql/tls/server.key
